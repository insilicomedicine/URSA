# Copy this file to .env. The real .env is ignored by Git.
#
LLM_API_KEY=

# Set only for a custom, proxy, or local endpoint.
# LLM_BASE_URL=http://localhost:4000

# LiteLLM also recognizes provider-specific keys. You can use one of these
# instead of LLM_API_KEY:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# Azure OpenAI uses these names directly. Pass the deployment at runtime as
# `--model azure/<deployment-name>`.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
